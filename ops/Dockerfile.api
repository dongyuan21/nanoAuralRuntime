FROM python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/nano-aural/src

RUN groupadd --system nano-aural \
    && useradd --system --gid nano-aural --home-dir /nonexistent nano-aural \
    && mkdir -p /opt/nano-aural/src /var/lib/nano-aural/canonical \
       /var/lib/nano-aural/staging /var/lib/nano-aural/attempts \
       /var/lib/nano-aural/workspaces \
    && chown -R nano-aural:nano-aural /var/lib/nano-aural

COPY ops/requirements-api.txt /opt/nano-aural/requirements-api.txt
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: \
    -r /opt/nano-aural/requirements-api.txt

# Copy only the model-agnostic Core/durable package.  The ControlFoley package,
# model weights, CUDA, torch, ComfyUI and upstream sources are not in this image.
COPY src/nano_aural_runtime /opt/nano-aural/src/nano_aural_runtime
COPY ops/load_secrets.py /opt/nano-aural/load_secrets.py

USER nano-aural:nano-aural
WORKDIR /opt/nano-aural

CMD ["python", "-m", "nano_aural_runtime.durable.service"]
